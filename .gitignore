# 系统与编辑器
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp

# 临时文件
*.tmp
*.bak
~$*

# 环境与密钥（任何情况下都不入库）
.env
.env.*
*.key
*.pem
web/config.js
web/config.local.js
web-v1/config.js

# 含个人信息的原始材料 —— 永不入库
raw/
private/
*.personal.*

# 依赖与缓存
__pycache__/
*.py[cod]
node_modules/
.venv/
venv/
.pytest_cache/

# 日志
*.log

# 导出产物：docx / pdf 默认不入库，docs/ 下的定稿版本例外
*.pdf
!docs/**/*.pdf
*.docx
!docs/**/*.docx

# 本地产物：发布标记与项目记忆不入库
.wbapp_*.genie
.workbuddy/

# 会话存档（含简历原文，只在服务端本机留一份）
server/.state/

# 本地副本（内含真实 config.js，不入库）
web-v1-copy/
